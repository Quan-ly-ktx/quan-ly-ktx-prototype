# ==============================================================================
# HỆ THỐNG QUẢN LÝ KÝ TÚC XÁ TƯ NHÂN (PDMS) - CẤU HÌNH BIẾN MÔI TRƯỜNG DUAL-MODE
# ==============================================================================

# Cờ bật/tắt chế độ Mock Data (Dual-Mode):
# - true  (Mặc định): Chạy độc lập hoàn toàn với Mock Data & LocalStorage (không cần backend).
# - false : Kết nối trực tiếp tới Backend Spring Boot REST API qua Vite reverse proxy `/api`.
VITE_USE_MOCK=true

# Địa chỉ Backend Spring Boot API khi chạy local
# Vite dev server sẽ reverse-proxy tiền tố `/api` tới backend này (tránh lỗi CORS).
VITE_API_BASE_URL=http://localhost:8080/api/v1
